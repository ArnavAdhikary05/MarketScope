# Python environments, bytecode, and test/lint caches
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node.js and frontend build output
node_modules/
frontend/dist/
